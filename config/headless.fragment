CONFIG_LOCALVERSION="-begonia-arch"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_EXT4_FS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_PHY_MTK_UFS=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_MT6360=y
CONFIG_MFD_MT6360=y
CONFIG_REGULATOR_MT6360=y
CONFIG_CHARGER_MT6360=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_NAMESPACES=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_DEBUG_INFO_BTF is not set
# Preserve upstream signing support, required by the selected security config.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
# Linux 6.16 controls this through MODULE_COMPRESS, not MODULE_COMPRESS_NONE.
# CONFIG_MODULE_COMPRESS is not set

# CSOT terminal stack. Touch modules probe after the real root firmware is available.
CONFIG_INPUT_EVDEV=y
CONFIG_DRM_PANEL_NOVATEK_NT36672A=y
CONFIG_TOUCHSCREEN_NOVATEK_NVT_TS_CORE=m
CONFIG_TOUCHSCREEN_NOVATEK_NVT_TS_SPI=m
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_MEDIATEK=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_SPI_MT65XX=y
CONFIG_MFD_TI_LMU=m
CONFIG_REGULATOR_LM363X=m
CONFIG_BACKLIGHT_LM36274=m
CONFIG_FW_LOADER=y
