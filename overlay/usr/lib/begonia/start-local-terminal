#!/bin/sh
set -eu
# Run as alarm. seatd owns DRM/input descriptors; no compositor root privileges.
for i in $(seq 1 90); do
    if ls /sys/class/drm/card*-DSI-*/status >/dev/null 2>&1; then
        exec dbus-run-session -- sway --config /etc/begonia/sway.conf --debug
    fi
    sleep 1
done
echo 'No DSI connector appeared in 90 seconds' >&2
exit 1
