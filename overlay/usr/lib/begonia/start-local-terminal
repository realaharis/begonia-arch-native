#!/bin/sh
# Experimental DRM session: keep SSH boot independent of the display.
set -eu
exec >>/var/log/begonia/local-terminal.log 2>&1
echo "Local terminal start: $(date -u)"
[ -e /dev/dri/card0 ] || { echo "No DRM device; skipping display"; exit 0; }
mkdir -p /run/begonia-ui
chmod 0700 /run/begonia-ui
export XDG_RUNTIME_DIR=/run/begonia-ui
export WAYLAND_DISPLAY=wayland-0
weston --backend=drm --idle-time=0 --log=/var/log/begonia/weston.log &
pid=$!
trap 'kill "$pid" 2>/dev/null || true' EXIT
i=0
while [ "$i" -lt 30 ]; do
  [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && break
  kill -0 "$pid" 2>/dev/null || { echo "Weston exited"; wait "$pid"; exit 1; }
  sleep 1
  i=$((i+1))
done
[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] || { echo "No Wayland socket"; exit 1; }
foot --fullscreen || true
wait "$pid"
