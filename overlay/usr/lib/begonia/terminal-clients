#!/bin/sh
# Always visible: virtual-keyboard-v1 + layer-shell, no text-input auto-popup dependency.
wvkbd-mobintl -l full,special,nav,persian --height 280 &
keyboard=$!
trap 'kill "$keyboard" 2>/dev/null || true' EXIT INT TERM
while :; do
    foot --app-id=begonia-terminal --font='DejaVu Sans Mono:size=11' /bin/bash -l
    sleep 1
done
